# Swift Package Manager
.build/
Package.resolved.lock
# Everything Xcode writes under .swiftpm stays ignored, xcuserdata and the per-user scheme
# management plist included. The exception is the scheme files in xcschemes, which is where Xcode
# writes a scheme marked Shared. The CI iOS job builds one of them (docs/development.md).
.swiftpm/*
!.swiftpm/xcode/
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata/
.swiftpm/xcode/xcshareddata/*
!.swiftpm/xcode/xcshareddata/xcschemes/
.swiftpm/xcode/xcshareddata/xcschemes/*
!.swiftpm/xcode/xcshareddata/xcschemes/*.xcscheme
*.xcodeproj
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
xcuserdata/
DerivedData/

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Local model weights and fixtures that are downloaded, never committed
Models/
.cache/

# Pinned upstream reference checkouts, created by `make upstream`
Upstream/

# Session task checklist (kept local)
TASKS.md

# Python virtual environments for the fixture scripts
.venv/

# Python bytecode caches from the fixture scripts
__pycache__/

# Stage dumps written by Tools/oracle/stage_dump.py (hundreds of MB each); never committed.
Tools/oracle/results/*.safetensors

# Instruments traces from profiling openjev-bench (docs/development.md)
*.trace
